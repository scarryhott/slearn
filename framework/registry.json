{
  "schemaVersion": 1,
  "repository": "Slearn",
  "unit": "source-grounded perspectival-curvature closure packet",
  "frames": [
    {
      "id": "OPEN",
      "purpose": "Provenance, observations, questions, and explicit unresolved remainders.",
      "resources": [
        "docs/SLEARN_SOURCE_PROVENANCE.md",
        "docs/SLEARN_ORIGINAL_VISION.md",
        "docs/SLEARN_CLOSURE_RESEARCH_LEDGER.md"
      ]
    },
    {
      "id": "PERSPECTIVE",
      "purpose": "Perspective, belief/value, WHY, goal, lesson/project/world grammar.",
      "resources": [
        "docs/SLEARN_EDUCATION_MODEL.md",
        "docs/SLEARN_ORIGINAL_VISION.md",
        "docs/SLEARN_CLOSURE_RESEARCH_LEDGER.md",
        "docs/DERIVED_PERSPECTIVAL_CLOSURE_HULL.md",
        "Slearn/DerivedPerspectivalClosureHull.lean",
        "framework/closure-ledger.json",
        "scripts/closure-packet-kernel.mjs",
        "scripts/project-closure-hull.mjs"
      ]
    },
    {
      "id": "CURVATURE",
      "purpose": "The source-defined fold among observation, belief/value, goal, WHY, explanation, definition, and alternative path; no numerical or physical metric is assumed.",
      "resources": [
        "docs/SLEARN_PERSPECTIVAL_CURVATURE_SPECIFICATION.md",
        "docs/PERSPECTIVAL_CURVATURE_CLOSURE_PRIMITIVES.md",
        "docs/SLEARN_ORIGINAL_VISION.md",
        "docs/NATURAL_RHYTHM_CLOSURE.md",
        "Slearn/NaturalRhythmClosure.lean",
        "Slearn/PerspectivalCurvatureClosurePrimitives.lean",
        "framework/source-closure-primitives.json",
        "scripts/run-source-closure.mjs"
      ]
    },
    {
      "id": "TRANSLATION",
      "purpose": "Admitted local/global orientations, bridge, closure contract, and scope of uniqueness.",
      "resources": [
        "Slearn/UniversalRelativeTranslationalCompletion.lean",
        "Slearn/NaturalRhythmClosure.lean",
        "docs/UNIVERSAL_RELATIVE_TRANSLATIONAL_COMPLETION.md",
        "docs/NATURAL_RHYTHM_CLOSURE.md"
      ]
    },
    {
      "id": "INTERACTION",
      "purpose": "Reciprocal paths, attempted episodes, finite interaction, and obstruction.",
      "resources": [
        "Slearn/ClosedTopologicalTranslation.lean",
        "Slearn/InteractiveTranslationalOpenFoundation.lean",
        "Slearn/ChaitinKakeyaTokenResuperposition.lean",
        "Slearn/NRRF652ClosureTranslationCommonOperationKakeyaTokenResuperposition.lean",
        "docs/CLOSED_TOPOLOGICAL_TRANSLATION.md",
        "docs/INTERACTIVE_TRANSLATIONAL_OPEN_FOUNDATION.md",
        "docs/CLOSURE_TRANSLATION_COMMON_OPERATION_NRRF652_NOTES.md"
      ]
    },
    {
      "id": "VERIFICATION",
      "purpose": "Source material, counter-reading, comparison method, review, finite-limit distinction, and proof boundary.",
      "resources": [
        "docs/SLEARN_CLOSURE_RESEARCH_LEDGER.md",
        "docs/SLEARN_TRANSLATIONAL_COMPLETION_FULL_TRANSLATION.md",
        "Slearn/InteractiveTranslationalOpenFoundation.lean"
      ]
    },
    {
      "id": "RETURN",
      "purpose": "Relation-relative recovery, residue, successor, and inherited next opening.",
      "resources": [
        "Slearn/ClosedTopologicalTranslation.lean",
        "Slearn/NRRF655ExecutablePerspectivalClosureEpisode.lean",
        "docs/CLOSED_TOPOLOGICAL_TRANSLATION.md",
        "docs/EXECUTABLE_PERSPECTIVAL_CLOSURE.md"
      ]
    },
    {
      "id": "ADMISSION",
      "purpose": "Relation-relative truth admission: a continued translation rather than a terminal preserved proposition.",
      "resources": [
        "docs/SLEARN_PERSPECTIVAL_CURVATURE_SPECIFICATION.md",
        "docs/PERSPECTIVAL_CURVATURE_CLOSURE_PRIMITIVES.md",
        "docs/SLEARN_CLOSURE_RESEARCH_LEDGER.md",
        "Slearn/UniversalRelativeTranslationalCompletion.lean",
        "Slearn/InteractiveTranslationalOpenFoundation.lean",
        "Slearn/PerspectivalCurvatureClosurePrimitives.lean",
        "Slearn/DerivedPerspectivalClosureHull.lean",
        "docs/DERIVED_PERSPECTIVAL_CLOSURE_HULL.md",
        "framework/source-closure-primitives.json",
        "framework/closure-ledger.json",
        "scripts/run-source-closure.mjs",
        "scripts/closure-packet-kernel.mjs",
        "scripts/project-closure-hull.mjs"
      ]
    },
    {
      "id": "PROJECTION",
      "purpose": "Integrated formal adapters, documentation, runtime, and optional interface projections.",
      "resources": [
        "Slearn/NRRF651SlearnUIHairOfClosureGeneratedMap.lean",
        "Slearn/NRRF654IntegratedFrameworkClosure.lean",
        "Slearn/DerivedPerspectivalClosureHull.lean",
        "Slearn.lean",
        "docs/FRAMEWORK_CLOSURE_INTEGRATION.md",
        "docs/GENERATED_UI_AND_TOKEN_RESUPERPOSITION.md",
        "ui/README.md",
        "ui/app/closureSources.ts",
        "ui/app/closureRuntime.ts",
        "ui/app/page.tsx",
        "ui/tests/closureRuntime.test.ts",
        "docs/DERIVED_PERSPECTIVAL_CLOSURE_HULL.md",
        "framework/closure-ledger.json",
        "scripts/project-closure-hull.mjs"
      ]
    }
  ],
  "routes": [
    ["OPEN", "PERSPECTIVE"],
    ["PERSPECTIVE", "CURVATURE"],
    ["CURVATURE", "TRANSLATION"],
    ["TRANSLATION", "INTERACTION"],
    ["INTERACTION", "VERIFICATION"],
    ["VERIFICATION", "ADMISSION"],
    ["ADMISSION", "RETURN"],
    ["RETURN", "OPEN"],
    ["OPEN", "PROJECTION"],
    ["PERSPECTIVE", "PROJECTION"],
    ["CURVATURE", "PROJECTION"],
    ["TRANSLATION", "PROJECTION"],
    ["INTERACTION", "PROJECTION"],
    ["VERIFICATION", "PROJECTION"],
    ["ADMISSION", "PROJECTION"],
    ["RETURN", "PROJECTION"]
  ],
  "rules": {
    "source_is_not_proof": true,
    "projection_is_not_authority": true,
    "curvature_requires_perspective_and_limit": true,
    "truth_admission_continues_translation": true,
    "return_requires_counter_reading": true,
    "finite_interaction_is_not_global_completion": true,
    "unresolved_remainder_is_preserved": true
  }
}
